#!/bin/sh
# SAFECODE_HOOK_VERSION: 1.0
# SafeCode managed pre-push hook. Client-side gate only; not the sole boundary.
# CI Required Checks + Branch Protection are independent defenses.
HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
# 优先用 git 给出的仓库根（Windows 上是 C:/... 形式，Windows Python 能直接吃）
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$REPO_ROOT" ]; then
  REPO_ROOT=$(cd "$HOOK_DIR/.." && pwd)
fi
# Git Bash / MSYS 下 pwd 会给 /c/... 形式，Windows Python 会误解成 C:\\c\\...，能转就转
if command -v cygpath >/dev/null 2>&1; then
  REPO_ROOT=$(cygpath -w "$REPO_ROOT" 2>/dev/null || echo "$REPO_ROOT")
fi
# 探测可用的 Python 解释器；找不到就阻断（fail-closed，绝不静默放行）
PY_BIN=""
if [ -n "$SAFECODE_PYTHON" ] && command -v "$SAFECODE_PYTHON" >/dev/null 2>&1; then
  PY_BIN="$SAFECODE_PYTHON"
elif command -v python3 >/dev/null 2>&1; then
  PY_BIN=python3
elif command -v python >/dev/null 2>&1; then
  PY_BIN=python
elif command -v py >/dev/null 2>&1; then
  PY_BIN="py -3"
else
  echo "SafeCode: no python interpreter found, blocking push (fail-closed)" >&2
  exit 1
fi
# 注意：git 会把 <remote-name> <remote-url> 作为位置参数传给 hook，
# 不能把它们转交给 SafeCode 脚本（那会变成用法错误，挡掉每一次推送）。
# hook 需要的 ref 信息走 stdin。调试参数请用 SAFECODE_PREPUSH_ARGS。
if [ -n "$SAFECODE_PREPUSH_ARGS" ]; then
  # shellcheck disable=SC2086
  exec $PY_BIN "$REPO_ROOT/scripts/pre-push.py" $SAFECODE_PREPUSH_ARGS
fi
exec $PY_BIN "$REPO_ROOT/scripts/pre-push.py"
