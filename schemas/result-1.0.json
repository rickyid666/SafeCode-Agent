{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safecode.dev/schema/result-1.0.json",
  "title": "SafeCode Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "decision",
    "severity",
    "category",
    "code",
    "message",
    "locations",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": ["PASS", "FAIL", "DEGRADED"]
    },
    "decision": {
      "enum": ["ALLOW", "DENY", "REQUIRE_APPROVAL"]
    },
    "severity": {
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "message": {
      "type": "string"
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "column": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
